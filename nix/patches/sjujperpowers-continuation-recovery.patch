+  }
+  const knowledgeEvidence = new Set([
+    ...snapshot.findings.flatMap((finding) => finding.evidence),
+    ...snapshot.decisions.flatMap((decision) => decision.evidence),
+    ...snapshot.rejectedApproaches.flatMap((rejected) => rejected.evidence),
+  ].map(evidenceKey));
+  for (const evidence of collectSnapshotEvidence(snapshot)) {
+    if (skipGeneric.has(evidenceKey(evidence)) && !knowledgeEvidence.has(evidenceKey(evidence))) continue;
+    try {
+      await verifyFileEvidence(evidence);
+    } catch (error) {
+      evidenceBlockers.push(error.blockers?.[0] ?? error.message);
+    }
+  }
+
+  const overlay = await reconcileKata({
+    snapshot,
+    identity,
+    execution,
+    showIssue: execution.provider === 'kata' ? (showIssue ?? defaultShowIssue) : undefined,
+    root: identity.root,
+    overlayStates: true,
+  });
+
+  const sourceMatches = snapshot.plan.sha256 === identity.sha256;
+  const tasks = attachBriefs(
+    identity,
+    overlay.tasks.map((task) => (
+      missingBriefs.has(task.number) ? { ...task, brief: null } : task
