+#!/usr/bin/env node
+
+import { realpathSync } from 'node:fs';
+import { readFile } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { parsePlan } from './materialize-plan.mjs';
+import { resolveConfig } from './resolve-config.mjs';
+import {
+  RecoveryError,
+  defaultPhase,
+  emptyTasks,
+  fileEvidence,
+  legacyWorkspaceDir,
+  normalizeSnapshot,
+  readProgress,
+  reconcileKata,
+  retainBytes,
+  retainSnapshotEvidence,
+  resolvePlanIdentity,
+  writeProgress,
+} from './recovery-lib.mjs';
+
+
+class CliUsageError extends Error {}
+
+const COMPLETE_RE = /^Task (\d+): complete \((.*)\)$/;
+const FIX_ROUND_RE = /^Task (\d+): fix round (\d+)\/5 \((.*)\)$/;
+const IMPLEMENTER_DONE_RE = /^Task (\d+): implementer DONE \((.*)\)$/;
+const MINOR_RE = /^Task (\d+): minor \(deferred\): (.+)$/;
+const PARKED_RE = /^Task (\d+): parked — (.+)$/;
+const RULING_TASK_RE = /^Task (\d+): Ruling: (.+)$/;
+const RULING_RE = /^Ruling: (.+)$/;
+const KATA_RE = /^Task (\d+): Kata (\S+)$/;
+const MODEL_RE = /^Task (\d+) implementer model: (.+)$/;
+const FIX_BASE_RE = /^Task (\d+): FIX_BASE (\S+)$/;
+const CHANGES_RE = /changes (\S+)\.\.(\S+)/;
+
+function parseChanges(text) {
+  const match = text.match(CHANGES_RE);
+  if (!match) return { base: null, head: null };
+  return { base: match[1], head: match[2] };
+}
+
+function splitRuling(text) {
+  const parts = text.split(' — ').map((part) => part.trim());
+  return {
+    summary: parts[0] ?? text,
+    rationale: parts[1] ?? text,
+    costIfWrong: parts[2] ?? null,
+  };
+}
+
+export function parseLegacyLedger(markdown, relativePath) {
+  const lines = markdown.split(/\r?\n/).map((line) => line.trimEnd());
+  const first = lines.find((line) => line.trim() !== '');
+  const identity = first?.match(/^# SDD ledger — plan: (.+)$/);
+  if (!identity) {
+    throw new RecoveryError('legacy ledger is missing a plan identity line', {
+      status: 'attention',
+      blockers: ['legacy-missing-identity'],
+    });
+  }
+  const namedPlan = identity[1].trim();
+  if (namedPlan !== relativePath) {
+    throw new RecoveryError(
+      `legacy ledger names ${namedPlan}, not ${relativePath}; leave it in place`,
+      {
+        status: 'contradictory',
+        blockers: ['legacy-other-plan', `named:${namedPlan}`],
+      },
+    );
+  }
+
+  const tasks = new Map();
+  let findings = [];
+  const decisions = [];
+  const rejectedApproaches = [];
+  const claims = [];
+
+  const blockers = [];
+  let findingSeq = 1;
+  let decisionSeq = 1;
+
+  const taskState = (number) => {
+    if (!tasks.has(number)) {
+      tasks.set(number, {
+        number,
+        state: 'pending',
+        phase: 'implement',
+        round: null,
+        nextAction: null,
+        commits: { base: null, head: null },
+        claim: null,
+      });
+    }
+    return tasks.get(number);
+  };
+
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (line === '' || line === first.trim()) continue;
+
+    let match = line.match(COMPLETE_RE);
+    if (match) {
+      const number = Number(match[1]);
+      const task = taskState(number);
+      task.state = 'complete';
+      task.phase = 'complete';
+      task.round = null;
+      task.commits = parseChanges(match[2]);
+      findings = findings.filter((finding) => !(finding.task === number && finding.status === 'open'));
+      continue;
+    }
+    match = line.match(FIX_ROUND_RE);
+    if (match) {
+      const number = Number(match[1]);
+      const task = taskState(number);
+      task.state = 'fix';
+      task.phase = 'fix';
+      task.round = Number(match[2]);
+      task.commits = parseChanges(match[3]);
+      findings = findings.filter((finding) => !(finding.task === number && finding.status === 'open'));
+      const detail = match[3];
+      const openMatch = detail.match(/(\d+) open — (.+?); changes /);
+      if (openMatch && Number(openMatch[1]) > 0) {
+        for (const summary of openMatch[2].split(';').map((part) => part.trim()).filter(Boolean)) {
+          findings.push({
+            id: `legacy-open-${findingSeq}`,
+            task: number,
+            status: 'open',
+            summary,
+            evidence: [],
+          });
+          findingSeq += 1;
+        }
+      }
+      task.nextAction = `resume fix round ${task.round} for task ${number}`;
+      continue;
+    }
+    match = line.match(IMPLEMENTER_DONE_RE);
+
+    if (match) {
+      const number = Number(match[1]);
+      const task = taskState(number);
+      task.state = 'review';
+      task.phase = 'review';
+      task.commits = parseChanges(match[2]);
+      task.nextAction = `review task ${number}`;
+      continue;
+    }
+    match = line.match(MINOR_RE);
+    if (match) {
+      findings.push({
+        id: `legacy-minor-${findingSeq}`,
+        task: Number(match[1]),
+        status: 'minor',
+        summary: match[2],
+        evidence: [],
+      });
+      findingSeq += 1;
+      continue;
+    }
+    match = line.match(PARKED_RE);
+    if (match) {
