+  const bytes = Buffer.from(text, 'utf8');
+  const digest = digestBytes(bytes);
+  return {
+    kind: 'regenerated',
+    task,
+    text,
+    byteLength: digest.byteLength,
+    sha256: digest.sha256,
+  };
+}
+
+async function defaultShowIssue({ root, project, ref }) {
+  const { stdout } = await execFile(
+    'kata',
+    ['--project', project, '--json', 'show', ref],
+    {
+      cwd: root,
+      encoding: 'utf8',
+      maxBuffer: 1024 * 1024,
+    },
+  );
+  try {
+    return JSON.parse(stdout);
+  } catch (error) {
+    throw new RecoveryError(`Kata show returned invalid JSON: ${error.message}`, {
+      status: 'attention',
+      blockers: [`kata-show-json:${ref}`],
+    });
+  }
+}
+
+function recoveryResult(status, blockers, capabilities) {
+  return {
+    eligible: status === 'eligible',
+    status,
+    blockers,
+    capabilities,
+  };
+}
+
+function capabilitiesFor(workflow, executionProvider) {
+  const capabilities = ['brief-regeneration', 'constraint-export'];
+  if (workflow === 'sdd') capabilities.push('sdd-review');
+  if (workflow === 'inline') capabilities.push('inline-execution');
+  if (executionProvider === 'session') capabilities.push('session-todos');
+  if (executionProvider === 'kata') capabilities.push('kata-claims');
+  return capabilities;
+}
+
+function evidenceKey(ref) {
+  return `${ref.path}\0${ref.byteLength}\0${ref.sha256}`;
+}
+
+function isMissingFileError(error) {
+  return error?.code === 'ENOENT';
+}
+
+function hasActiveReview(snapshot, task) {
+  return task.state === 'review'
+    || task.state === 'fix'
+    || snapshot.findings.some((finding) => finding.task === task.number && finding.status === 'open');
+}
+
+function attachBriefs(identity, tasks, { sourceMatches = true } = {}) {
+  if (!sourceMatches) return tasks;
+  return tasks.map((task) => {
+    if (task.brief) return task;
+    return {
+      ...task,
+      brief: regeneratedBrief(task.number, extractTaskBody(identity.markdown, task.number)),
+    };
+  });
+}
+
+function currentFromTasks(snapshot, tasks) {
+  const contradictory = tasks.find((task) => task.state === 'contradictory');
+  if (contradictory) {
+    return {
+      task: contradictory.number,
+      phase: contradictory.phase,
+      round: contradictory.round,
+      nextAction: `resolve contradictory child state for task ${contradictory.number}`,
+    };
+  }
+  const active = tasks.find((task) =>
+    task.state === 'in_progress'
+    || task.state === 'review'
+    || task.state === 'fix'
+    || task.state === 'blocked',
+  );
+  if (active) {
+    return {
+      task: active.number,
+      phase: active.phase,
+      round: active.round,
+      nextAction: active.nextAction ?? snapshot.current.nextAction,
+    };
+  }
+  const pending = tasks.find((task) => task.state === 'pending');
+  if (pending) {
+    return {
+      task: pending.number,
+      phase: pending.phase,
+      round: pending.round,
+      nextAction: pending.nextAction ?? snapshot.current.nextAction,
+    };
+  }
+  const unlanded = tasks.find((task) => task.state === 'complete_unlanded');
+  if (unlanded) {
+    return {
+      task: unlanded.number,
+      phase: 'complete',
+      round: null,
+      nextAction: snapshot.current.nextAction,
+    };
+  }
+  return {
+    task: snapshot.current.task,
+    phase: snapshot.current.phase,
+    round: snapshot.current.round,
+    nextAction: snapshot.current.nextAction,
+  };
+}
+
+function baseProjection({
+  identity,
+  parsedPlan,
+  workflow,
+  execution,
+  constraints,
+  recovery,
+  revision = 0,
+  current,
+  tasks,
+  findings = [],
+  decisions = [],
+  rejectedApproaches = [],
+  evidence = [],
+  claims = [],
+  todos = null,
+}) {
+  const selectedWorkflow = workflow ?? 'sdd';
+  const phase = current?.phase ?? 'unenrolled';
+  return {
+    version: 1,
+    plan: {
+      root: identity.root,
+      relativePath: identity.relativePath,
+      sha256: identity.sha256,
+    },
+    workflow: selectedWorkflow,
+    execution,
+    revision,
+    constraints,
+    current: current ?? {
+      task: parsedPlan.tasks[0]?.number ?? null,
+      phase,
+      round: null,
+      nextAction: recovery.blockers.includes('not-enrolled')
+        ? 'record an explicit recovery snapshot before fresh handoff'
+        : 'stop; recovery is not eligible',
+    },
+    tasks: tasks ?? parsedPlan.tasks.map((task) => ({
+      number: task.number,
+      title: task.title,
+      state: 'pending',
+      phase: phase === 'unenrolled' ? defaultPhase(selectedWorkflow) : phase,
+      round: null,
+      nextAction: null,
+      brief: regeneratedBrief(task.number, extractTaskBody(identity.markdown, task.number)),
+      report: null,
+      reviewPackage: null,
+      claim: null,
+      commits: { base: null, head: null },
+    })),
+    findings,
+    decisions,
+    rejectedApproaches,
+    evidence,
+    claims,
+    todos,
+    recovery,
+  };
+}
+
+function liveClaim(claim, status) {
+  if (!claim) return null;
+  return {
+    kind: 'provider',
+    provider: 'kata',
+    ref: claim.ref,
+    uid: claim.uid ?? null,
+    project: claim.project ?? null,
+    shortId: claim.shortId ?? null,
+    observedRevision: status === 'unknown' ? null : claim.observedRevision,
+    status,
+    task: claim.task ?? null,
+    labels: status === 'unknown' ? [] : claim.labels ?? [],
+    owner: status === 'unknown' ? null : claim.owner ?? null,
+    lease: status === 'unknown' ? null : claim.lease ?? null,
+    claimOwner: status === 'unknown' ? null : claim.owner ?? claim.lease?.holder ?? null,
+  };
+}
+
+export async function exportRecovery({
+  root,
+  planPath,
+  workflow,
+  showIssue,
+  config,
+  runtimeCheck = false,
+} = {}) {
+  const identity = await resolvePlanIdentity(root, planPath);
+  const parsedPlan = parsePlan(identity.markdown);
+  const constraints = extractGlobalConstraints(identity.markdown);
+  const resolvedConfig = config ?? await resolveConfig(identity.root, { runtimeCheck });
+  const execution = {
+    provider: resolvedConfig.execution.provider,
+    ...(resolvedConfig.execution.provider === 'kata'
+      ? { project: resolvedConfig.execution.project }
+      : {}),
+    completion: resolvedConfig.execution.completion,
+  };
+  const progress = await readProgress(identity);
+  const selectedWorkflow = workflow ?? (progress.kind === 'snapshot' ? progress.raw?.workflow : 'sdd');
+  const capabilities = capabilitiesFor(selectedWorkflow, execution.provider);
+
+  if (progress.kind === 'legacy') {
+    return baseProjection({
+      identity,
+      parsedPlan,
+      workflow: selectedWorkflow,
+      execution,
+      constraints,
+      recovery: recoveryResult('attention', [
+        'legacy-ledger-unenrolled',
+        `legacy-path:${identity.progressPath}`,
+      ], capabilities),
+    });
+  }
+  if (progress.kind === 'unknown') {
+    return baseProjection({
+      identity,
+      parsedPlan,
+      workflow: selectedWorkflow,
+      execution,
+      constraints,
+      current: {
+        task: null,
+        phase: 'unsupported',
+        round: null,
+        nextAction: 'stop; recovery format is unsupported',
+      },
+      recovery: recoveryResult('unsupported', ['unsupported-progress-format'], capabilities),
+    });
+  }
+  if (progress.kind === 'missing') {
+    return baseProjection({
+      identity,
+      parsedPlan,
+      workflow: selectedWorkflow,
+      execution,
+      constraints,
+      recovery: recoveryResult('ineligible', ['not-enrolled'], capabilities),
+    });
+  }
