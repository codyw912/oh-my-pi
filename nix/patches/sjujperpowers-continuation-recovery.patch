+import { exportRecovery } from '../../skills/tracking-providers/scripts/export-recovery.mjs';
+import { migrateRecovery, parseLegacyLedger } from '../../skills/tracking-providers/scripts/migrate-recovery.mjs';
+import {
+  extractGlobalConstraints,
+  extractTaskBody,
+  parsePlan,
+} from '../../skills/tracking-providers/scripts/materialize-plan.mjs';
+import {
+  normalizeSnapshot,
+  planKey,
+  resolvePlanIdentity,
+} from '../../skills/tracking-providers/scripts/recovery-lib.mjs';
+import { recordRecovery } from '../../skills/tracking-providers/scripts/record-recovery.mjs';
+
+const PLAN = `# Recovery Fixture Implementation Plan
+
+**Spec:** \`docs/project/specs/example.md\`
+
+**Source:** plane:AGENT-12
+
+## Global Constraints
+
+- Do not publish protected configuration
+- Preserve exact review rounds
+
+---
+
+### Task 1: First
+
+First body with token ALPHA.
+
+### Task 2: Second
+
+Second body with token BRAVO.
+
+### Task 3: Third
+
+Third body with token CHARLIE.
+`;
+
+function sha256(text) {
+  return createHash('sha256').update(text, 'utf8').digest('hex');
+}
+
+function sessionConfig() {
+  return {
+    version: 1,
+    configPath: '/fixture/.sjujperpowers/config.json',
+    docsRoot: 'docs/project',
+    roadmap: { provider: 'file' },
+    execution: { provider: 'session', completion: 'landed' },
+  };
+}
+
+function noneConfig() {
+  return {
+    ...sessionConfig(),
+    execution: { provider: 'none', completion: 'landed' },
+  };
+}
+
+function kataConfig() {
+  return {
+    version: 1,
+    configPath: '/fixture/.sjujperpowers/config.json',
+    docsRoot: 'docs/project',
+    roadmap: { provider: 'file' },
+    execution: { provider: 'kata', project: 'sjujperpowers', completion: 'landed' },
+  };
+}
+
+function kataIssue({
+  shortId,
+  task,
+  status = 'open',
+  revision = 4,
+  plan = 'docs/project/plans/feature.md',
+  owner = null,
+  lease = null,
+} = {}) {
+  return {
+    issue: {
+      id: task,
+      uid: `uid-${shortId}`,
+      project_id: 1,
+      short_id: shortId,
+      title: `Task ${task}`,
+      body: '',
+      status,
+      owner,
+      author: 'agent',
+      metadata: {
+        'sjujperpowers.plan': plan,
+        'sjujperpowers.task': String(task),
+      },
+      revision,
+      created_at: '2026-09-09T00:00:00Z',
+      updated_at: '2026-09-09T00:00:00Z',
+    },
+    comments: [],
+    links: [],
+    labels: [{ issue_id: task, label: 'sjujperpowers-task', author: 'agent' }],
+    lease,
+    pending_leases: [],
+    lease_hub_now: null,
+    lease_violations: [],
+  };
+}
+
+function taskClaims() {
+  return [1, 2, 3].map((task) => ({
+    kind: 'provider',
+    provider: 'kata',
+    ref: `sjujperpowers#t${task}`,
+    observedRevision: null,
+    task,
+  }));
+}
+
+function fakeShow(issues, calls) {
+  return async ({ ref }) => {
+    calls.push(['show', ref]);
+    if (!issues[ref]) throw new Error(`missing ${ref}`);
+    return issues[ref];
+  };
+}
+
+function showTasks(overrides = {}, calls = []) {
+  const issues = {
+    'sjujperpowers#t1': kataIssue({ shortId: 't1', task: 1, ...(overrides.t1 ?? {}) }),
+    'sjujperpowers#t2': kataIssue({ shortId: 't2', task: 2, ...(overrides.t2 ?? {}) }),
+    'sjujperpowers#t3': kataIssue({ shortId: 't3', task: 3, ...(overrides.t3 ?? {}) }),
+  };
+  return fakeShow(issues, calls);
+}
+
+function assertDefined(value, path = 'root') {
+  assert.notEqual(value, undefined, `${path} must not be undefined`);
+  if (Array.isArray(value)) {
+    value.forEach((item, index) => assertDefined(item, `${path}[${index}]`));
+    return;
+  }
+  if (value && typeof value === 'object') {
+    for (const [key, child] of Object.entries(value)) {
+      assertDefined(child, `${path}.${key}`);
+    }
+  }
+}
+
+async function fixture(planRelative = 'docs/project/plans/feature.md', markdown = PLAN) {
+  const root = await mkdtemp(join(tmpdir(), 'sjujperpowers-recovery-'));
+  const planPath = join(root, planRelative);
+  await mkdir(dirname(planPath), { recursive: true });
+  await writeFile(planPath, markdown);
+  const identity = await resolvePlanIdentity(root, planPath);
+  return { root: identity.root, planPath: identity.planPath, identity, planRelative };
+}
+
+test('extractGlobalConstraints and extractTaskBody reuse the plan parser', () => {
+  assert.deepEqual(parsePlan(PLAN).tasks.map((task) => task.title), ['First', 'Second', 'Third']);
+  assert.deepEqual(extractGlobalConstraints(PLAN), [
+    '- Do not publish protected configuration',
+    '- Preserve exact review rounds',
+  ]);
+  const brief = extractTaskBody(PLAN, 2);
+  assert.match(brief, /Second body with token BRAVO/);
+  assert.doesNotMatch(brief, /Global Constraints/);
+});
+
+test('fix rounds, rejected approaches, and exact evidence survive export', async () => {
+  const { root, planPath, identity } = await fixture();
+  const reportPath = join(identity.workspace, 'task-2-report.md');
+  const report = 'open finding: missing progress reporting\n';
+  const recorded = await recordRecovery({
+    root,
+    planPath,
+    config: sessionConfig(),
+    event: {
+      workflow: 'sdd',
+      type: 'fix-round',
+      task: 2,
+      round: 2,
+      nextAction: 'resume implementer with open findings',
+      current: { task: 2, phase: 'fix', round: 2, nextAction: 'resume implementer with open findings' },
+      tasks: [
+        { number: 1, state: 'complete', phase: 'complete', round: null },
+        { number: 2, state: 'fix', phase: 'fix', round: 2, nextAction: 'resume implementer with open findings' },
+      ],
+      findings: [{
+        id: 'f1',
+        task: 2,
+        status: 'open',
+        summary: 'missing progress reporting',
+        evidence: [],
+      }],
+      rejectedApproaches: [{
+        id: 'r1',
+        task: 2,
+        summary: 'rewrite the formatter from scratch',
+        reason: 'loses the reviewed Task 1 interface',
+        evidence: [],
+      }],
+      todos: [{ id: 't2', content: 'Task 2', status: 'in_progress' }],
+      writeFiles: [{ path: reportPath, contents: report }],
+    },
+  });
+  assert.equal(recorded.acknowledged, true);
+  assert.equal(recorded.revision, 1);
+  assert.match(recorded.eventId, /:r1$/);
+  assert.equal(recorded.evidence[0].sha256, sha256(report));
+  assert.equal(recorded.snapshotEvidence.kind, 'file');
+
+  const projection = await exportRecovery({ root, planPath, config: sessionConfig() });
+  assertDefined(projection);
+  assert.equal(projection.current.round, 2);
+  assert.equal(projection.rejectedApproaches[0].summary, 'rewrite the formatter from scratch');
+  assert.equal(projection.recovery.status, 'eligible');
+});
+
+test('retained snapshot survives replacement and evidenceRefs keep exact hashes', async () => {
+  const { root, planPath, identity } = await fixture();
+  const archive = join(identity.workspace, 'history.log');
+  const prefix = 'decision: keep the reviewed base\n';
+  await mkdir(identity.workspace, { recursive: true });
+  await writeFile(archive, prefix);
+  const first = await recordRecovery({
+    root,
+    planPath,
+    config: sessionConfig(),
+    event: {
+      workflow: 'sdd',
+      current: { task: 1, phase: 'implement', round: null, nextAction: 'continue task 1' },
+      todos: [{ id: 't1', content: 'Task 1', status: 'in_progress' }],
+      evidenceRefs: [{
+        kind: 'file',
+        path: archive,
+        byteLength: Buffer.byteLength(prefix),
+        sha256: sha256(prefix),
+      }],
+    },
+  });
+  await writeFile(archive, `${prefix}later appendix\n`);
+  const second = await recordRecovery({
+    root,
+    planPath,
+    config: sessionConfig(),
+    event: {
+      expectedRevision: 2,
+      nextAction: 'continue after retain',
+      todos: [{ id: 't1', content: 'Task 1', status: 'in_progress' }],
+    },
+  });
+  assert.equal(second.revision, 2);
+  assert.equal(second.retained.length, 1);
+  assert.equal(second.retained[0].sha256, first.snapshotEvidence.sha256);
+  assert.equal(sha256(await readFile(first.snapshotEvidence.path, 'utf8')), first.snapshotEvidence.sha256);
+  const projection = await exportRecovery({ root, planPath, config: sessionConfig() });
