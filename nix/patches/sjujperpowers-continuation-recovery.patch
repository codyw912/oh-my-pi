+  const snapshot = normalizeSnapshot(progress.raw, identity, parsedPlan);
+  const evidenceBlockers = [];
+  const publishedBytes = Buffer.from(progress.markdown, 'utf8');
+  const publishedDigest = digestBytes(publishedBytes);
+  const publication = {
+    kind: 'file',
+    path: join(identity.retainedDir, `${publishedDigest.sha256}-snapshot-r${snapshot.revision}.md`),
+    ...publishedDigest,
+  };
+  let publicationVerified = false;
+  try {
+    await verifyFileEvidence(publication);
+    publicationVerified = true;
+  } catch {
+    evidenceBlockers.push(`unacknowledged-snapshot:${snapshot.revision}`);
+  }
+  const skipGeneric = new Set();
+  const missingBriefs = new Set();
+  const missingReview = new Set();
+  for (const task of snapshot.tasks) {
+    if (task.brief) {
+      try {
+        await verifyFileEvidence(task.brief);
+      } catch (error) {
+        skipGeneric.add(evidenceKey(task.brief));
+        if (isMissingFileError(error)) missingBriefs.add(task.number);
