+  let status = 'eligible';
+  if (contradictory) status = 'contradictory';
+  else if (observationFailed || evidenceBlockers.length > 0) status = 'attention';
+  else if (snapshot.plan.sha256 !== identity.sha256) status = 'attention';
+  else if (execution.provider === 'session' && (!snapshot.todos || snapshot.todos.length === 0)) {
+    status = 'ineligible';
+    blockers.push('session-todos-missing');
+  } else if (execution.provider === 'none' && !sufficientNoneFacts(snapshot)) {
+    status = 'ineligible';
+    blockers.push('none-recovery-facts-missing');
+  }
+
+  if (status === 'eligible') capabilities.push('fresh-handoff');
+
+  return {
+    version: 1,
+    plan: {
+      root: identity.root,
+      relativePath: identity.relativePath,
+      sha256: identity.sha256,
+    },
+    workflow: snapshot.workflow,
+    execution,
+    revision: snapshot.revision,
+    constraints,
+    current,
+    tasks: tasks.map((task) => ({
+      ...task,
+      claim: liveClaim(task.claim, task.claim?.status ?? 'unknown'),
+    })),
+    findings: snapshot.findings,
+    decisions: snapshot.decisions,
+    rejectedApproaches: snapshot.rejectedApproaches,
+    evidence: (publicationVerified ? [...snapshot.evidence, publication] : snapshot.evidence)
+      .filter((item) => !skipGeneric.has(evidenceKey(item))),
+    claims,
+    todos: snapshot.todos,
+    recovery: recoveryResult(status, blockers, capabilities),
+  };
+}
+
+function parseArgs(args) {
+  let root = process.cwd();
+  let planPath = null;
+  let workflow;
+  for (let index = 0; index < args.length; index += 1) {
+    const arg = args[index];
+    const value = args[index + 1];
+    if (arg === '--root') {
+      if (!value) throw new CliUsageError('--root requires a directory');
+      root = resolve(value);
+      index += 1;
+    } else if (arg === '--plan') {
+      if (!value) throw new CliUsageError('--plan requires a path');
+      planPath = value;
+      index += 1;
+    } else if (arg === '--workflow') {
+      if (!value) throw new CliUsageError('--workflow requires sdd or inline');
+      workflow = value;
+      index += 1;
+    } else {
+      throw new CliUsageError(`unknown argument: ${arg}`);
+    }
+  }
