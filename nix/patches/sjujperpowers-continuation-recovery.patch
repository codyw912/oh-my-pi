+    version: 1,
+    plan: { relativePath: identity.relativePath, sha256: identity.sha256 },
+    workflow: 'sdd',
+    execution,
+    revision: 1,
+    current: currentFromMigrated(attached.tasks),
+    tasks: attached.tasks,
+    findings: parsed.findings,
+    decisions: parsed.decisions,
+    rejectedApproaches: parsed.rejectedApproaches,
+    evidence: [preservedOriginal, ...attached.evidence],
+    claims: parsed.claims,
+    todos: execution.provider === 'session' ? [] : null,
