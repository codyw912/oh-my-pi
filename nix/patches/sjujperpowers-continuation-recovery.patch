+test('changed plan contents cannot reuse or overwrite the acknowledged digest', async () => {
+  const { root, planPath, identity } = await fixture();
+  const oldDigest = identity.sha256;
+  const recorded = await recordRecovery({
+    root,
+    planPath,
+    config: sessionConfig(),
+    event: {
+      workflow: 'sdd',
+      current: { task: 1, phase: 'implement', round: null, nextAction: 'implement task 1' },
+      tasks: [{ number: 1, state: 'in_progress', phase: 'implement', round: null }],
+      todos: [{ id: 't1', content: 'Task 1', status: 'in_progress' }],
+    },
+  });
+  const progressBefore = await readFile(identity.progressPath, 'utf8');
+  const snapshotBytes = await readFile(recorded.snapshotEvidence.path);
+  assert.equal(sha256(snapshotBytes), recorded.snapshotEvidence.sha256);
+  assert.match(progressBefore, new RegExp(oldDigest));
+
+  const mutated = PLAN.replace('token ALPHA', 'token MUTATED-ALPHA');
+  await writeFile(planPath, mutated);
+  const reopened = await resolvePlanIdentity(root, planPath);
+  assert.notEqual(reopened.sha256, oldDigest);
+
+  const projection = await exportRecovery({ root, planPath, config: sessionConfig() });
+  assert.equal(projection.recovery.eligible, false);
+  assert.notEqual(projection.recovery.status, 'eligible');
+  assert.ok(projection.recovery.blockers.includes(`plan-digest-changed:${oldDigest}:${reopened.sha256}`));
+  assert.ok(!projection.recovery.capabilities.includes('fresh-handoff'));
+  assert.ok(projection.tasks.every((task) => task.brief?.kind !== 'regenerated'));
+  for (const task of projection.tasks) {
+    if (task.brief?.text) assert.doesNotMatch(task.brief.text, /MUTATED-ALPHA/);
+  }
+  assert.equal(await readFile(identity.progressPath, 'utf8'), progressBefore);
+
+  await assert.rejects(
+    recordRecovery({
+      root,
+      planPath,
+      config: sessionConfig(),
+      event: {
+        expectedRevision: 2,
+        nextAction: 'continue after plan mutation',
+        todos: [{ id: 't1', content: 'Task 1', status: 'in_progress' }],
+      },
+    }),
+    (error) => {
+      assert.match(error.message, /plan digest changed/);
+      assert.ok(error.blockers.some((item) => item.startsWith('plan-digest-changed:')));
+      assert.ok(error.blockers.some((item) => item.includes(oldDigest) && item.includes(reopened.sha256)));
+      return true;
+    },
+  );
+
+  assert.equal(await readFile(identity.progressPath, 'utf8'), progressBefore);
+  assert.equal(sha256(await readFile(recorded.snapshotEvidence.path)), recorded.snapshotEvidence.sha256);
+  assert.doesNotMatch(await readFile(identity.progressPath, 'utf8'), /MUTATED-ALPHA/);
+  assert.match(await readFile(identity.progressPath, 'utf8'), new RegExp(oldDigest));
+  assert.doesNotMatch(await readFile(identity.progressPath, 'utf8'), new RegExp(reopened.sha256));
+});
