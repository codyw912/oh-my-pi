+    `# Recovery — \`${snapshot.plan.relativePath}\``,
+    '',
+    `Workflow: ${snapshot.workflow} · execution: ${snapshot.execution.provider} · revision: ${snapshot.revision}`,
+    '',
+    '## Current',
+    `- Task: ${snapshot.current.task === null ? 'none' : snapshot.current.task}`,
+    `- Phase: ${snapshot.current.phase}`,
+    `- Round: ${snapshot.current.round === null ? 'none' : `${snapshot.current.round}/5`}`,
+    `- Next: ${snapshot.current.nextAction}`,
+    '',
+    '## Tasks',
+    ...tasks,
+    '',
+    renderList('Findings', snapshot.findings, (finding) =>
+      `- T${finding.task} ${finding.status}: ${finding.summary}`,
+    ),
+    '',
+    renderList('Decisions', snapshot.decisions, (decision) =>
+      `- ${decision.sourceText ?? `${decision.summary} — ${decision.rationale}`}`,
+    ),
+    '',
+    renderList('Rejected approaches', snapshot.rejectedApproaches, (item) =>
+      `- ${item.summary} — ${item.reason}`,
+    ),
+    '',
+    renderList('Evidence', snapshot.evidence, (item) =>
+      `- ${item.path} (${item.byteLength} bytes, sha256 ${item.sha256})`,
+    ),
+    '',
+    renderList('Claims', snapshot.claims, (claim) =>
