+test('legacy conversion requires explicit enrollment and copies the original', async () => {
+  const { root, planPath, identity } = await fixture();
+  const legacyDir = join(root, '.sjujperpowers/sdd/feature');
+  await mkdir(legacyDir, { recursive: true });
+  const legacy = `# SDD ledger — plan: docs/project/plans/feature.md
+Task 1: complete (changes aaa..bbb, review clean)
+Task 2: implementer DONE (changes bbb..ccc)
+Task 2: fix round 1/5 (0 addressed, 1 open — missing progress reporting; changes ccc..ddd)
+`;
+  const legacyPath = join(legacyDir, 'progress.md');
+  await writeFile(legacyPath, legacy);
+  await writeFile(join(legacyDir, 'task-2-report.md'), 'report\n');
+  await assert.rejects(
+    migrateRecovery({ root, planPath, config: sessionConfig(), enroll: false }),
+    /explicit enroll/,
+  );
+  const migrated = await migrateRecovery({ root, planPath, config: sessionConfig(), enroll: true });
+  assert.equal(migrated.enrolled, true);
+  assert.equal(migrated.preservedOriginal.sha256, sha256(legacy));
+  assert.match(migrated.preservedOriginal.path, /retained/);
+  assert.equal(await readFile(legacyPath, 'utf8'), legacy);
+  assert.equal(migrated.snapshot.tasks[1].round, 1);
+});
