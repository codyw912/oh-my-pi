+export function extractGlobalConstraints(markdown) {
+  const structuralMarkdown = withoutFencedCode(markdown);
+  const heading = /^## Global Constraints\s*$/m.exec(structuralMarkdown);
+  if (!heading) return [];
+  const rest = structuralMarkdown.slice(heading.index + heading[0].length);
+  const end = rest.search(/\n(?:---\s*$|#{1,6} )/m);
+  const body = (end === -1 ? rest : rest.slice(0, end)).replace(/^\n+/, '').replace(/\n+$/, '');
+  if (body === '') return [];
+  return body.split('\n').filter((line) => line.trim() !== '');
+}
+
+export function extractTaskBody(markdown, number) {
+  if (!Number.isInteger(number) || number < 1) {
+    throw new Error(`task ${number} not found`);
+  }
+  const lines = markdown.split('\n');
+  let infence = false;
+  let intask = false;
+  const out = [];
+  const heading = new RegExp(`^#+[ \\t]+Task[ \\t]+${number}([^0-9]|$)`);
+  for (const line of lines) {
+    if (/^```/.test(line)) infence = !infence;
+    if (!infence && /^#+\s+Task\s+\d+/.test(line)) {
+      intask = heading.test(line);
+    }
+    if (intask) out.push(line);
+  }
+  if (out.length === 0) throw new Error(`task ${number} not found`);
+  return `${out.join('\n')}\n`;
+}
