+    item.startsWith('kata-show-failed:')
+    || item.startsWith('kata-status-unknown:')
+    || item.startsWith('kata-revision-missing:')
+    || item.startsWith('kata-show-missing-issue:')
+    || item.startsWith('missing-task-mapping:')
+    || item.startsWith('kata-plan-metadata-mismatch:')
+    || item.startsWith('kata-task-metadata-mismatch:')
+    || item.startsWith('kata-label-missing:')
+    || item.startsWith('kata-ref-project-mismatch:')
+    || item.startsWith('kata-short-id-mismatch:')
+    || item.startsWith('kata-owner-changed:')
+    || item.startsWith('kata-lease-released:')
+    || item.startsWith('kata-lease-expired:')
+    || item.startsWith('kata-lease-foreign:')
+    || item.startsWith('kata-lease-replaced:')
+    || item === 'missing-kata-show',
+  );
