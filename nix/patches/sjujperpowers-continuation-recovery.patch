+
+test('missing task brief regenerates from the acknowledged plan source', async () => {
+  const { root, planPath, identity } = await fixture();
+  const briefText = extractTaskBody(PLAN, 1);
+  const briefPath = join(identity.workspace, 'task-1-brief.md');
+  const recorded = await recordRecovery({
+    root,
+    planPath,
+    config: sessionConfig(),
+    event: {
+      workflow: 'sdd',
+      current: { task: 1, phase: 'implement', round: null, nextAction: 'implement task 1' },
