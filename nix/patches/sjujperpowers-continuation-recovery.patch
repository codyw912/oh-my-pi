+    if (!referenced.some((item) => item.claim.ref === claim.ref && item.task === claim.task)) {
+      referenced.push({ task: claim.task, claim });
+    }
+  }
+
+  const claims = [];
+  for (const item of referenced) {
+    const ref = item.claim.ref;
+    let payload;
+    try {
+      payload = await showIssue({ root, project: execution.project, ref });
+    } catch {
+      blockers.push(`kata-show-failed:${ref}`);
+      continue;
+    }
+    const observed = observeKataShow(payload, {
+      project: execution.project,
+      relativePath: identity.relativePath,
+      task: item.task,
+      ref,
+    });
+    blockers.push(...observed.blockers);
+    if (
+      observed.blockers.length > 0
+      || observed.observation === null
+      || observed.observation.observedRevision === null
+      || observed.observation.status === 'unknown'
+    ) {
+      continue;
+    }
+    const live = observed.observation;
+    blockers.push(...authorityBlockers(
+      item.claim,
+      live,
+      typeof payload?.lease_hub_now === 'string' ? payload.lease_hub_now : null,
+      ref,
+    ));
+    claims.push(live);
+    if (item.task !== null) {
+      const task = tasks.find((entry) => entry.number === item.task);
+      if (task) {
+        task.claim = live;
+        if (overlayStates) {
+          const unfinishedReview = task.state === 'review' || task.state === 'fix'
+            || (task.round !== null && task.state !== 'complete');
+          if (task.state === 'complete' && live.status === 'open') {
+            task.state = 'complete_unlanded';
+          } else if (live.status === 'closed' && (unfinishedReview || task.state !== 'complete')) {
+            task.state = 'contradictory';
+            blockers.push(`closed-child-unfinished-review:task-${task.number}:${ref}`);
+          }
+        }
+      }
+    }
+  }
+  return { tasks, claims, blockers };
+}
+
+async function main(args) {
+  let root = process.cwd();
+  let planPath = null;
+  let mode = null;
+  for (let index = 0; index < args.length; index += 1) {
+    const arg = args[index];
+    const value = args[index + 1];
+    if (arg === '--root') {
+      if (!value) throw new Error('--root requires a directory');
+      root = resolve(value);
+      index += 1;
+    } else if (arg === '--plan') {
+      if (!value) throw new Error('--plan requires a path');
+      planPath = value;
+      index += 1;
+    } else if (arg === '--workspace-path' || arg === '--identity') {
+      mode = arg === '--identity' ? 'identity' : 'workspace';
+    } else {
+      throw new Error(`unknown argument: ${arg}`);
+    }
+  }
+  if (planPath === null) throw new Error('--plan is required');
+  if (mode === null) throw new Error('--workspace-path or --identity is required');
+  const identity = await resolvePlanIdentity(root, planPath);
+  if (mode === 'workspace') {
+    process.stdout.write(`${identity.workspace}\n`);
+    return;
+  }
+  process.stdout.write(`${JSON.stringify({
+    root: identity.root,
+    relativePath: identity.relativePath,
+    planKey: identity.planKey,
+    workspace: identity.workspace,
+    sha256: identity.sha256,
+  })}\n`);
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === realpathSync(resolve(process.argv[1]))) {
+  try {
+    await main(process.argv.slice(2));
+  } catch (error) {
+    process.stderr.write(`${error.message}\n`);
+    process.exitCode = 1;
+  }
+}
