+import assert from 'node:assert/strict';
+import { mkdtemp, readFile, readdir, rm } from 'node:fs/promises';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import test from 'node:test';
+import { configureProviders } from '../../skills/setting-up-tracking-providers/scripts/configure-providers.mjs';
+
+async function temporaryRoot(t) {
+  const root = await mkdtemp(join(tmpdir(), 'sjujperpowers-configure-'));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  return root;
+}
+
+function fileSessionConfig() {
+  return {
+    version: 1,
+    docsRoot: 'docs/project/',
+    roadmap: { provider: 'file' },
+    execution: { provider: 'session', completion: 'landed' },
+  };
+}
+
+test('writes one normalized provider configuration atomically', async t => {
+  const root = await temporaryRoot(t);
+
+  const config = await configureProviders(root, fileSessionConfig(), {
+    preflightKataFn: async () => assert.fail('session execution must not preflight Kata'),
+  });
+
+  assert.equal(config.docsRoot, 'docs/project');
+  assert.deepEqual(JSON.parse(await readFile(join(root, '.sjujperpowers/config.json'), 'utf8')), {
+    version: 1,
+    docsRoot: 'docs/project',
+    roadmap: { provider: 'file' },
+    execution: { provider: 'session', completion: 'landed' },
+  });
+});
+
+test('preflights the selected Kata project before writing', async t => {
+  const root = await temporaryRoot(t);
+  const projects = [];
+
+  await configureProviders(
+    root,
+    {
+      version: 1,
+      roadmap: { provider: 'plane', project: 'Homelab' },
+      execution: { provider: 'kata', project: 'homelab', completion: 'pull_request' },
+    },
+    {
+      preflightKataFn: async project => projects.push(project),
+    },
+  );
+
+  assert.deepEqual(projects, ['homelab']);
+  const persisted = JSON.parse(await readFile(join(root, '.sjujperpowers/config.json'), 'utf8'));
+  assert.equal(persisted.roadmap.project, 'Homelab');
+  assert.equal(persisted.execution.project, 'homelab');
+  assert.equal(persisted.execution.completion, 'pull_request');
+});
+
+test('leaves no configuration when Kata preflight fails', async t => {
+  const root = await temporaryRoot(t);
+  const failure = new Error('kata project unavailable');
+
+  await assert.rejects(
+    configureProviders(
+      root,
+      {
+        version: 1,
+        roadmap: { provider: 'file' },
+        execution: { provider: 'kata', project: 'missing', completion: 'landed' },
+      },
+      { preflightKataFn: async () => { throw failure; } },
+    ),
+    failure,
+  );
+  await assert.rejects(readFile(join(root, '.sjujperpowers/config.json')), { code: 'ENOENT' });
+});
+
+test('refuses to replace existing project policy without overwrite', async t => {
+  const root = await temporaryRoot(t);
+  await configureProviders(root, fileSessionConfig());
+
+  await assert.rejects(
+    configureProviders(root, fileSessionConfig()),
+    /already exists; pass --overwrite to replace it/,
+  );
+});
+
+test('requires active Plane guidance across shipped lifecycle skills', async () => {
+  const skillsRoot = new URL('../../skills/', import.meta.url);
+  const entries = await readdir(skillsRoot, { recursive: true });
+  const skillFiles = entries.filter(path => path.endsWith('SKILL.md'));
+  const corpus = (await Promise.all(skillFiles.map(path => readFile(new URL(path, skillsRoot), 'utf8')))).join('\n');
+
+  const tracking = await readFile(new URL('tracking-providers/SKILL.md', skillsRoot), 'utf8');
+  const brainstorming = await readFile(new URL('brainstorming/SKILL.md', skillsRoot), 'utf8');
+  const roadmapping = await readFile(new URL('roadmapping/SKILL.md', skillsRoot), 'utf8');
+  const finishing = await readFile(new URL('finishing-a-change-stack/SKILL.md', skillsRoot), 'utf8');
+
+  assert.match(tracking, /Plane is an active shared backlog/);
+  assert.match(brainstorming, /do not create it during context exploration/);
+  assert.match(brainstorming, /after design approval.*create or reuse the outcome.*then save/i);
+  assert.match(roadmapping, /Routine outcome creation and maintenance/);
+  assert.match(finishing, /post the roll-up as a Plane\s+comment/);
+  assert.doesNotMatch(corpus, /Plane support is reference-based|integration is reference-only|do not .*mutate Plane|Do not apply it|carries an existing external outcome reference|require.*existing.*plane/i);
+});
