@@ -0,0 +1,154 @@
+#!/usr/bin/env node
+
+import { realpathSync } from 'node:fs';
+import { access, mkdir, rename, rm, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { normalizeConfig, preflightKata } from '../../tracking-providers/scripts/resolve-config.mjs';
+
+class CliUsageError extends Error {}
+
+export async function configureProviders(
+  root,
+  raw,
+  { overwrite = false, preflightKataFn = preflightKata } = {},
+) {
+  const configPath = resolve(root, '.sjujperpowers/config.json');
+  const config = normalizeConfig(raw, configPath);
+
+  if (config.execution.provider === 'kata') {
+    await preflightKataFn(config.execution.project, { configPath });
+  }
+
+  if (!overwrite) {
+    try {
+      await access(configPath);
+      throw new Error(`${configPath} already exists; pass --overwrite to replace it`);
+    } catch (error) {
+      if (error.code !== 'ENOENT') throw error;
+    }
+  }
+
+  await mkdir(dirname(configPath), { recursive: true });
+  const temporaryPath = `${configPath}.tmp-${process.pid}`;
+  try {
+    const persisted = {
+      version: config.version,
+      docsRoot: config.docsRoot,
+      roadmap: config.roadmap,
+      execution: config.execution,
+    };
+    await writeFile(temporaryPath, `${JSON.stringify(persisted, null, 2)}\n`, { mode: 0o644 });
+    await rename(temporaryPath, configPath);
+  } catch (error) {
+    await rm(temporaryPath, { force: true });
+    throw error;
+  }
+
+  return config;
+}
+
+function takeValue(args, index, option) {
+  const value = args[index + 1];
+  if (!value) throw new CliUsageError(`${option} requires a value`);
+  return value;
+}
+
+function parseArgs(args) {
+  const values = {
+    root: process.cwd(),
+    docsRoot: 'docs/project',
+    completion: 'landed',
+    overwrite: false,
+  };
+
+  for (let index = 0; index < args.length; index += 1) {
+    const option = args[index];
+    if (option === '--overwrite') {
+      values.overwrite = true;
+      continue;
+    }
+    if (option === '--help' || option === '-h') {
+      values.help = true;
+      continue;
+    }
+
+    const value = takeValue(args, index, option);
+    index += 1;
+    switch (option) {
+      case '--root':
+        values.root = resolve(value);
+        break;
+      case '--docs-root':
+        values.docsRoot = value;
+        break;
+      case '--roadmap':
+        values.roadmap = value;
+        break;
+      case '--roadmap-project':
+        values.roadmapProject = value;
+        break;
+      case '--execution':
+        values.execution = value;
+        break;
+      case '--execution-project':
+        values.executionProject = value;
+        break;
+      case '--completion':
+        values.completion = value;
+        break;
+      default:
+        throw new CliUsageError(`unknown option: ${option}`);
+    }
+  }
+
+  return values;
+}
+
+function usage() {
+  return `Usage: configure-providers.mjs [options]\n\n` +
+    `  --root DIR                    Repository root (default: cwd)\n` +
+    `  --docs-root DIR               Versioned project docs root (default: docs/project)\n` +
+    `  --roadmap file|plane|none\n` +
+    `  --roadmap-project NAME        Required for Plane\n` +
+    `  --execution session|kata|none\n` +
+    `  --execution-project NAME      Required for Kata\n` +
+    `  --completion landed|pull_request\n` +
+    `  --overwrite                   Replace an existing configuration\n`;
+}
+
+async function main() {
+  try {
+    const options = parseArgs(process.argv.slice(2));
+    if (options.help) {
+      process.stdout.write(usage());
+      return;
+    }
+    if (!options.roadmap) throw new CliUsageError('--roadmap is required');
+    if (!options.execution) throw new CliUsageError('--execution is required');
+
+    const roadmap = { provider: options.roadmap };
+    if (options.roadmapProject !== undefined) roadmap.project = options.roadmapProject;
+    const execution = { provider: options.execution, completion: options.completion };
+    if (options.executionProject !== undefined) execution.project = options.executionProject;
+
+    const config = await configureProviders(
+      options.root,
+      {
+        version: 1,
+        docsRoot: options.docsRoot,
+        roadmap,
+        execution,
+      },
+      { overwrite: options.overwrite },
+    );
+    process.stdout.write(`${JSON.stringify(config)}\n`);
+  } catch (error) {
+    process.stderr.write(`${error.message}\n`);
+    process.exitCode = error instanceof CliUsageError ? 2 : 1;
+  }
+}
+
+if (process.argv[1] && realpathSync(fileURLToPath(import.meta.url)) === realpathSync(resolve(process.argv[1]))) {
+  await main();
+}
